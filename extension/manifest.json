{
  "manifest_version": 3,
  "name": "Note Learn helper",
  "version": "1.0.0",
  "description": "Send the page you are reading to Note, then ask about it and open each term in its own thread.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "action": { "default_title": "Send this page to Note" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://augustof2022.github.io/notes/*", "http://127.0.0.1:5173/*"],
    "js": ["note-bridge.js"],
    "run_at": "document_idle"
  }],
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+N" } } }
}