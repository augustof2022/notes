# Server only. Copy this file outside the repository and keep it private.
# Use the SAME Google web OAuth client configured in Supabase Authentication.
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
# Generate once with: openssl rand -base64 32
DRIVE_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Exact origins only, no paths, wildcard, or trailing slash.
DRIVE_ALLOWED_ORIGINS=https://augustof2022.github.io
# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY when deployed.
